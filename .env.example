# Dockhand MCP Server — environment variables
# Copy this file to .env and fill in your Dockhand configuration.

# Dockhand server URL (required)
DOCKHAND_URL=http://your-dockhand-instance:3866

# Authentication: provide EITHER a scoped Bearer API token (recommended)
# OR username + password for cookie-based session login.
DOCKHAND_API_TOKEN=dh_your_api_token_here
# DOCKHAND_USERNAME=admin
# DOCKHAND_PASSWORD=your-password-here

# Optional settings
# DOCKHAND_DEFAULT_ENV=1
# DOCKHAND_READ_ONLY=false
# DOCKHAND_VERIFY_SSL=true
# DOCKHAND_TIMEOUT=60.0
# DOCKHAND_DISABLE_TOOLS=
